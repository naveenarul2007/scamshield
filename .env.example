# ScamShield Environment Configuration
# Flask App Settings
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5001
SECRET_KEY=scamshield-secret-hackathon-algothon-2026

# Database Configuration
# Default: SQLite database stored in database/scamshield.db
# For PostgreSQL / Supabase, provide the connection URI:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/scamshield
DATABASE_URL=sqlite:///database/scamshield.db

# Optional Supabase Integration (if using Supabase client API)
SUPABASE_URL=
SUPABASE_KEY=

# Optional Tesseract OCR binary path (e.g. /usr/local/bin/tesseract or /opt/homebrew/bin/tesseract)
TESSERACT_CMD=
